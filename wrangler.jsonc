{
  // =====================================================================
  // Deployed from the Cloudflare dashboard — no terminal required.
  //
  // Configured. The one thing NOT here is JWT_SECRET, which is a Secret rather
  // than a var: set it under Settings -> Variables and Secrets.
  //
  // Full walkthrough: docs/deploy.md
  // =====================================================================
  "$schema": "node_modules/wrangler/config-schema.json",

  // The Worker script name. This is the identity Cloudflare stores secrets,
  // routes and deployments against, so renaming it later creates a *new*
  // worker and orphans the old one's secrets — including JWT_SECRET, which
  // would sign every existing session out.
  "name": "zipr-site",

  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // This app server-renders every page, so unmatched paths are handled
    // by the worker's own notFound, not by an SPA shell. "none" keeps the
    // asset layer from swallowing 404s that should reach your router.
    "not_found_handling": "none",
  },

  "observability": {
    "enabled": true,
  },

  "dev": {
    "port": 3000,
    "local_protocol": "http",
  },

  // ---------------------------------------------------------------------
  // Everything below is production. Cloudflare builds and deploys this on
  // every push once the repo is connected under Settings -> Builds.
  //
  // Adding a staging environment later means adding an "env": { "staging":
  // {...} } block — but named environments INHERIT NOTHING, so every binding
  // and var must be repeated inside it, and it deploys a SEPARATE worker with
  // its own secrets. See the appendix in docs/deploy.md.
  // ---------------------------------------------------------------------

  // `zone_name` is only required when the record is ambiguous; a custom_domain
  // on a zone in the same account resolves without it.
  "routes": [
    {
      "pattern": "zipr.stanbrook.me",
      "custom_domain": true,
    },
  ],

  // Dashboard: Storage & Databases -> D1. These ids are not secrets — they are
  // useless without an API token for the account — which is why they live in
  // version control rather than in a variable.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zipr-db",
      "database_id": "e10e0a6c-32d0-4bd2-ad06-ef5f1b2c24be",
      "migrations_dir": "drizzle",
    },
  ],

  // Dashboard: R2. Holds the installer objects; the worker streams them back
  // rather than the bucket being public, so nothing here is world-readable.
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "zipr-r2",
    },
  ],

  // Edge rate limiting. `namespace_id` is an arbitrary number you pick per
  // limiter within this worker — it is NOT a resource to provision, so
  // nothing here needs changing. Used by the auth API to throttle login
  // attempts by IP before they reach the database.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],

  "vars": {
    "ENVIRONMENT": "production",

    // --- BRANDING ---
    // How the site names itself in the title, nav and footer.
    "APP_NAME": "Zipr",
    "APP_TAGLINE": "Every tool your team uses, one keystroke away.",
    "APP_LOCALE": "en-AU",
    "APP_CURRENCY": "USD",

    // --- CORE AUTH ---
    // Enabled methods: passkey, password, pin, totp, email, sms
    //
    // No `passkey`, deliberately and necessarily: the WebAuthn challenge is
    // stored in KV between the options call and the verify call, and this site
    // has no KV namespace. Re-enabling it means re-adding the binding here and
    // `KV` to the Bindings type in worker/types.ts — the passkey code itself is
    // untouched and still present.
    "AUTH_METHODS": "password,totp",

    // Milliseconds.
    "SESSION_DURATION": "86400000",
    "SESSION_RENEWAL_THRESHOLD": "3600000",
    "MAX_SESSIONS_PER_USER": "5",

    // SECONDS — not milliseconds. This sets the JWT `exp` claim and the
    // cookie Max-Age directly. Pasting a millisecond value here (86400000)
    // yields a ~2.7 YEAR session, not a day. 86400 = 24 hours.
    "JWT_EXPIRY": "86400",

    // --- SECURITY ---
    // JWT_SECRET is deliberately absent: it is a SECRET, not a var. Set it in
    // the dashboard under Settings -> Variables and Secrets, type "Secret".
    // Putting it here commits it to git and leaks it to anyone with repo
    // access. See docs/deploy.md.
    "MAX_FAILED_LOGIN_ATTEMPTS": "5",
    "LOCKOUT_DURATION": "900000",
    "REQUIRE_EMAIL_VERIFICATION": "false",
    "REQUIRE_PHONE_VERIFICATION": "false",
    // Comma-separated allowlist. Empty means open registration.
    // Set this for an invite-only or single-user site.
    // Belt and braces. /register already 404s once an admin exists, so this
    // list has nothing to guard in the normal case — it is here for the window
    // before the first registration, and for any later one made deliberately.
    "ALLOWED_EMAILS": "jared@stanbrook.me",

    // First-run admin, so you never need a terminal to get one. Register
    // normally with this exact email and that account becomes an admin — but
    // ONLY while no admin exists yet, so it disarms itself the moment it
    // works. Safe to leave set; tidier to clear afterwards.
    "BOOTSTRAP_ADMIN_EMAIL": "jared@stanbrook.me",

    // --- ROLES & PERMISSIONS ---
    // Convention:
    //   resource.action      → the action on rows the user owns
    //   resource.action.any  → the action on anyone's rows
    //   "*"                  → expands to all of PERMISSIONS_AVAILABLE
    // Keep the resource names in sync with the `Resource` type in
    // worker/services/access.service.ts.
    "ROLES_AVAILABLE": "user,admin",
    "ROLES_DEFAULT": "user",
    // Roles that cannot be self-assigned at registration. Get your first
    // admin with BOOTSTRAP_ADMIN_EMAIL below — no terminal needed.
    "ROLES_RESTRICTED": "admin",
    "PERMISSIONS_AVAILABLE": "releases.read,releases.create,releases.update,releases.delete,issues.read,issues.update,issues.delete",
    // `user` is the default role and holds no permissions: signing in grants
    // nothing on its own. Every staff surface is admin-only, and a narrower
    // grant is available per user through the user_permissions table.
    "ROLES_INHERENT": "admin:*",

    // --- PASSKEY / WEBAUTHN ---
    // Passkey sign-in is off (see AUTH_METHODS above — it needs KV, and this
    // site has none), so RP_NAME and RP_ID are currently unused and kept only
    // so re-enabling it is a one-line change. RP_ID is the bare hostname, no
    // scheme and no port.
    //
    // ORIGIN is the canonical URL every page declares to search engines and
    // the base for sitemap.xml, so it has to match the route above exactly.
    "RP_NAME": "Zipr",
    "RP_ID": "zipr.stanbrook.me",
    "ORIGIN": "https://zipr.stanbrook.me",

    // --- PASSWORD CONFIG ---
    "PASSWORD_MIN_LENGTH": "8",
    "PASSWORD_REQUIRE_UPPERCASE": "true",
    "PASSWORD_REQUIRE_LOWERCASE": "true",
    "PASSWORD_REQUIRE_NUMBERS": "true",
    "PASSWORD_REQUIRE_SPECIAL": "true",

    // --- PIN CONFIG ---
    "PIN_LENGTH": "6",
    "PIN_NUMBERS_ONLY": "true",

    // --- TOTP CONFIG ---
    // TOTP_ISSUER is the name shown in the user's authenticator app.
    "TOTP_ISSUER": "Zipr",
    "TOTP_ALGORITHM": "SHA1",
    "TOTP_DIGITS": "6",
    "TOTP_PERIOD": "30",
  },
}
